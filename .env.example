# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# In Vercel, add these same keys under Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SERVER-ONLY. Bypasses Row Level Security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---------------------------------------------------------------
# Dashboard → Developers → API keys. Use test keys (sk_test_… / pk_test_…) in dev.
STRIPE_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
# From `stripe listen` locally, or the webhook endpoint's signing secret in prod.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# --- App ------------------------------------------------------------------
# Used to build absolute URLs (Stripe redirects, emails). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
